# Supabase project (Settings → API in the Supabase dashboard)
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...

# Shared password that gates the whole app (there is no per-user login yet)
APP_PASSWORD=change-me
# Any random string, used to sign the session cookie
APP_SESSION_SECRET=change-me-too
